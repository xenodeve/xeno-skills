#!/usr/bin/env bash
# SYNC: this file must stay BYTE-IDENTICAL to skills/t4/t4-project-bootstrap/references/hooks/t4-subagent-stop
#       (tests/hooks/test-bootstrap-sync.sh). Edit here, then copy over -- the bootstrap
#       ships its own copies so a repo installed without the plugin is self-contained.
# Release on stop_hook_active at the subagent boundary, and count the correction
# where the flag flips (#225).
#
# A BLOCKING HOOK AT THIS BOUNDARY WITHOUT A RELEASE CONDITION DOES NOT DEGRADE --
# IT DESTROYS THE TURN AND BILLS FOR IT. The guard was in the payload the whole
# time: `stop_hook_active: true` means "you have already blocked this one", on both
# hosts that carry the tier. The related runaway was measured on antigravity, where
# returning the keep-going decision every call ran 168 extra turns to timeout.
#
# The counter increments at the flag TRANSITION and nowhere else. `corrections` is
# the number the developer asked the reviewer to report -- how many times the worker
# was pulled up -- and counted anywhere else it either double-counts a re-delivery
# or misses a genuine second objection. Both make the figure worse than none.
set -uo pipefail

payload="$(cat)"
[ -f ".claude/t4.json" ] || exit 0
command -v python >/dev/null 2>&1 || exit 0
HERE="$(cd "$(dirname "$0")" && pwd)"

# Absent flag means NOT YET BLOCKED. Stated because the default decides the
# runaway: reading absence as "already blocked" would silence the tier entirely,
# and reading it as "block again" is the loop this hook exists to prevent.
active="$(printf '%s' "$payload" | python -c '
import json, sys
try:
    print("1" if json.load(sys.stdin).get("stop_hook_active") else "0")
except Exception:
    print("0")
' 2>/dev/null || printf '0')"

if [ "$active" = "1" ]; then
  exit 0                      # already blocked once -- release, silently
fi

# Not yet blocked: this is a NEW objection. Count it where the flag flips.
if [ -f "$HERE/t4-review-state" ]; then
  fid="$(python -c '
import json, sys
try:
    s = json.load(open(".claude/t4-review-state.json", encoding="utf-8"))
except Exception:
    sys.exit(0)
open_ = [f for f in s.get("findings", [])
         if not any(d.get("finding") == f.get("finding") for d in s.get("decided", []))]
print(open_[0]["finding"] if open_ else "")
' 2>/dev/null || true)"
  if [ -n "$fid" ]; then
    printf '{"op":"correct","finding":"%s"}' "$fid" \
      | bash "$HERE/t4-review-state" >/dev/null 2>&1 || true
  fi
fi

exit 0
