# Local Claude permissions — not part of the committed operating layer
.claude/settings.local.json

# Skill-invocation log written by the local tooling into the committed vault.
# Keyed by session UUID and machine, so it conflicts on every clone that runs a skill —
# and as an untracked *.log inside tracked territory it trips .githooks/check-tree-budget
# on every push (#258).
Obsidian-xeno-skills/skill-usage/.invocations.log

# Python bytecode. Two .pyc files were committed by this branch -- `rule-traces.py`
# imports `rule-census.py` through importlib, which writes a cache beside the source,
# and `git add -A` swept it in. They are build output of a generator, not the generator.
__pycache__/
*.pyc

# Hook-written RUNTIME STATE, not configuration. The reviewer's state file, the receipt
# counters and the canary's off switch are written into .claude/ by the hooks while a
# session runs — per machine, per session, and meaningless in anyone else's checkout.
# Untracked inside tracked territory is how the invocation log ended up blocking every
# push (#258); these three are the same class, and are listed before they are written
# rather than after. tests/guards/test-check-tree-budget.sh asserts all four.
.claude/t4-review-state.json
.claude/t4-receipt-counts.json
.claude/t4-canary-disabled
